[Unit]
Description=Overnight rumor scans: evening (post-close chatter) and pre-open

[Timer]
# 21:30 catches the evening build-up; 05:45 catches what brewed overnight,
# still comfortably before the 09:30 open. Times are the BOX's local clock —
# keep the box on America/New_York (see DEPLOY.md).
OnCalendar=Sun..Thu 21:30
OnCalendar=Mon..Fri 05:45
Persistent=true

[Install]
WantedBy=timers.target
